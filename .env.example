# Copy to .env (git-ignored) and fill in. Only GEMINI_API_KEY is required.
GEMINI_API_KEY=

# Model used by every agent. Changing it invalidates the evaluation's LLM cache.
# GEMINI_MODEL=gemini-3.1-flash-lite

# --- Public-deployment guards (0 disables a limit) ---
# MAX_CODE_CHARS=20000          # reject larger submissions with 413
# RATE_LIMIT_PER_MINUTE=6       # per client IP
# DAILY_REVIEW_BUDGET=100       # all clients together, resets at midnight UTC; one review is ~4 Gemini calls
# MAX_CONCURRENT_REVIEWS=3      # each review runs up to 3 static-analysis processes
# TRUST_PROXY_HEADERS=false     # true only behind a proxy that sets X-Forwarded-For (Render, Fly, ...), else the per-IP limit sees the proxy

# --- Origins ---
# CORS_ORIGINS=http://localhost:5173   # comma-separated; needed only if the UI is hosted on a different origin
# STATIC_DIR=                          # built UI to serve; defaults to client/dist when it exists

# Extra Semgrep registry packs (needs network access), comma-separated. The bundled rules are always used.
# SEMGREP_EXTRA_CONFIGS=p/owasp-top-ten
