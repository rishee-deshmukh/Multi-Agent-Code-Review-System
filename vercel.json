{
  "builds": [
    {
      "src": "server/main.py",
      "use": "@vercel/python",
      "config": {
        "maxDuration": 60
      }
    },
    {
      "src": "client/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    }
  ],
  "routes": [
    {
      "src": "/(health|review|stream)(/.*)?",
      "dest": "server/main.py"
    },
    {
      "src": "/(.*)",
      "dest": "client/$1"
    }
  ]
}
